# MandiBhav by GramIQ — Environment Configuration
# Copy this file to .env and fill in your values.
# The pipeline works in dev mode WITHOUT any OGD key.

# ---------------------------------------------------------------
# REQUIRED for article generation
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------
# OPTIONAL — Pipeline mode
# "dev"  = use CSV fixtures from data/mock/ (default, no API key needed)
# "live" = fetch from data.gov.in OGD API
# ---------------------------------------------------------------
PIPELINE_MODE=demo

# ---------------------------------------------------------------
# OPTIONAL — Only needed when PIPELINE_MODE=live
# OGD test key from the public docs:
# 579b464db66ec23bdd000001a19088a22a72469b46974157ac49b624
# Replace it with your own key for sustained usage.
# ---------------------------------------------------------------
OGD_API_KEY=your_ogd_api_key_here

# Optional override for the OGD mandi resource.
# Default points to:
# Current Daily Price of Various Commodities from Various Markets (Mandi)
OGD_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional page size per OGD request. Increase only if needed.
OGD_PAGE_LIMIT=1000

# ---------------------------------------------------------------
# OPTIONAL — LLM model override (default: gemini-2.5-flash)
# ---------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash
