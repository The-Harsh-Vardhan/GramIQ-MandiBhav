# MandiBhav by GramIQ — Environment Configuration
# Copy this file to .env and fill in your values.
# The pipeline works in dev mode WITHOUT any API keys.

# ---------------------------------------------------------------
# REQUIRED for article generation
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------
# OPTIONAL — Pipeline mode
# "dev"  = use CSV fixtures from data/mock/ (default, no API key needed)
# "live" = fetch from data.gov.in OGD API
# ---------------------------------------------------------------
PIPELINE_MODE=dev

# ---------------------------------------------------------------
# OPTIONAL — Only needed when PIPELINE_MODE=live
# ---------------------------------------------------------------
OGD_API_KEY=your_ogd_api_key_here

# ---------------------------------------------------------------
# OPTIONAL — LLM model override (default: gemini-2.5-flash)
# ---------------------------------------------------------------
# GEMINI_MODEL=gemini-2.5-flash
